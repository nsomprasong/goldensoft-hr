    "dotenv": "^17.4.2",
    "next": "^15.5.21",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
