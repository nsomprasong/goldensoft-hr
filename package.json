{
  "name": "goldensoft-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build --turbopack",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/phase8a-integration.test.ts tests/legacy-untouched.test.ts tests/migration-safety.test.ts tests/phase8b-schema.test.ts tests/phase8b-security.test.ts tests/phase8b-employees.test.ts tests/phase8b-compensation.test.ts tests/phase8b-shifts.test.ts tests/phase8b-overtime.test.ts tests/phase8b-payroll.test.ts tests/phase8b-seed.test.ts tests/phase8b-ui.test.ts",
    "git:diff-check": "git diff --check",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:migration:check": "tsx scripts/migration-check.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "seed:hr": "tsx scripts/seed-hr.ts",
    "seed:hr:demo": "tsx scripts/seed-hr-demo.ts",
    "seed:hr:demo:cleanup": "tsx scripts/seed-hr-demo-cleanup.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
