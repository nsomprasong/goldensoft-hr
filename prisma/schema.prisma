// GoldenSoft HR — PostgreSQL schema "hr"
//
// Architecture rules enforced here:
//   1. Every model lives in schema "hr". HR never owns objects in platform/auth/public.
//   2. No PostgreSQL or Prisma enums — status/type columns point at master tables
//      that carry an immutable unique `code`.
//   3. organization_id / branch_id / platform_user_id / auth_user_id are soft UUID
//      references. There is deliberately no foreign key to the platform or auth schemas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["hr"]
}

// ─── Master / Lookup tables ───────────────────────────────────────────────

/// DAILY | MONTHLY | CONTRACT | TEMPORARY
model EmploymentType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@map("employment_types")
  @@schema("hr")
}

/// ACTIVE | INACTIVE | RESIGNED | TERMINATED | SUSPENDED
model EmployeeStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@map("employee_statuses")
  @@schema("hr")
}

/// NOT_LINKED | PENDING_ACTIVATION | ACTIVE | DISABLED — account login gate (not employment).
model EmployeeAccountAccessStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@map("employee_account_access_statuses")
  @@schema("hr")
}

/// OTP_VERIFICATION | INVITATION | NO_NOTIFICATION
model EmployeeOnboardingMethod {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees   Employee[]
  challenges  EmployeeActivationChallenge[]

  @@map("employee_onboarding_methods")
  @@schema("hr")
}

/// PENDING | VERIFIED | EXPIRED | CANCELLED
model EmployeeActivationStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenges EmployeeActivationChallenge[]

  @@map("employee_activation_statuses")
  @@schema("hr")
}

/// REGULAR | NIGHT | SPLIT | OFF | LEAVE
model ShiftType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shifts Shift[]

  @@map("shift_types")
  @@schema("hr")
}

/// SEMIMONTHLY | MONTHLY | WEEKLY | DAILY
model PayFrequency {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payrollSchedules PayrollSchedule[]

  @@map("pay_frequencies")
  @@schema("hr")
}

/// DAILY | MONTHLY | HOURLY
model WageType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  compensations EmployeeCompensation[]

  @@map("wage_types")
  @@schema("hr")
}

/// NORMAL_DAY | HOLIDAY | REST_DAY | SPECIAL
model OvertimeRateType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  overtimeRules OvertimeRule[]

  @@map("overtime_rate_types")
  @@schema("hr")
}

/// DRAFT | OPEN | CALCULATING | REVIEW | APPROVED | PAID | LOCKED
model PayrollPeriodStatus {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payrollPeriods     PayrollPeriod[]
  payrollRuns        PayrollRun[]         @relation("PayrollRunStatus")
  payrollRunEmployees PayrollRunEmployee[] @relation("PayrollRunEmployeeStatus")

  @@map("payroll_period_statuses")
  @@schema("hr")
}

/// Audit vocabulary, e.g. employee.create / payroll_period.status_change
model AuditActionType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameTh      String   @map("name_th")
  nameEn      String   @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs AuditLog[]

  @@map("audit_action_types")
  @@schema("hr")
}

// ─── Organization-scoped structure ────────────────────────────────────────

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  /// Soft reference to a Platform organization (no cross-schema FK).
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  nameTh         String   @map("name_th")
  nameEn         String   @map("name_en")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  positions Position[]
  employees Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("departments")
  @@schema("hr")
}

model Position {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  code           String
  nameTh         String   @map("name_th")
  nameEn         String   @map("name_en")
  description    String?
  branchId       String?  @map("branch_id") @db.Uuid
  positionTypeId String?  @map("position_type_id") @db.Uuid
  scopeTypeId    String?  @map("scope_type_id") @db.Uuid
  immutableCode  String?  @map("immutable_code")
  isSystemStandard Boolean @default(false) @map("is_system_standard")
  defaultRoleId  String?  @map("default_role_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]
  assignmentHistory EmployeeAssignmentHistory[]
  positionType PositionType? @relation(fields: [positionTypeId], references: [id], onDelete: Restrict)
  scopeType PositionScopeType? @relation(fields: [scopeTypeId], references: [id], onDelete: Restrict)
  roles PositionRole[]
  sourceRoleAssignments EmployeeRoleAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([departmentId])
  @@index([organizationId, branchId, isActive])
  @@map("positions")
  @@schema("hr")
}

model PositionType {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameTh String @map("name_th")
  nameEn String @map("name_en")
  description String?
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  positions Position[]
  @@map("position_types")
  @@schema("hr")
}

model PositionScopeType {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameTh String @map("name_th")
  nameEn String @map("name_en")
  description String?
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  positions Position[]
  @@map("position_scope_types")
  @@schema("hr")
}

model PositionRole {
  id String @id @default(uuid()) @db.Uuid
  positionId String @map("position_id") @db.Uuid
  organizationRoleId String @map("organization_role_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  @@unique([positionId, organizationRoleId])
  @@index([organizationRoleId])
  @@map("position_roles")
  @@schema("hr")
}

/// Physical clock-in site. Geofence is stored here for Phase 8C attendance.
model WorkLocation {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  /// Soft reference to a Platform branch (no cross-schema FK).
  branchId              String   @map("branch_id") @db.Uuid
  code                  String
  name                  String
  latitude              Decimal? @db.Decimal(10, 7)
  longitude             Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters  Int      @default(50) @map("geofence_radius_meters")
  timezone              String   @default("Asia/Bangkok")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employeeWorkLocations EmployeeWorkLocation[]
  shiftAssignments      ShiftAssignment[]
  attendanceEvents      AttendanceEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([branchId])
  @@map("work_locations")
  @@schema("hr")
}

// ─── Employee ─────────────────────────────────────────────────────────────

model Employee {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  employeeCode     String    @map("employee_code")
  /// Soft link to platform.user_profiles.id — nullable until the person has a Platform account.
  platformUserId   String?   @map("platform_user_id") @db.Uuid
  /// Soft link to auth.users.id — nullable until the person can sign in.
  authUserId       String?   @map("auth_user_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  departmentId     String?   @map("department_id") @db.Uuid
  positionId       String?   @map("position_id") @db.Uuid
  employmentTypeId String    @map("employment_type_id") @db.Uuid
  employeeStatusId String    @map("employee_status_id") @db.Uuid
  /// Separate from employment status — gates login/product access for this employee row.
  accountAccessStatusId String? @map("account_access_status_id") @db.Uuid
  onboardingMethodId    String? @map("onboarding_method_id") @db.Uuid
  accountActivatedAt    DateTime? @map("account_activated_at") @db.Timestamptz(6)
  accountDisabledAt     DateTime? @map("account_disabled_at") @db.Timestamptz(6)
  firstNameTh      String    @map("first_name_th")
  lastNameTh       String    @map("last_name_th")
  firstNameEn      String?   @map("first_name_en")
  lastNameEn       String?   @map("last_name_en")
  displayName      String    @map("display_name")
  phone            String
  email            String?
  photoUrl         String?   @map("photo_url")
  emergencyContactName String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  hireDate         DateTime  @map("hire_date") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date
  resignationDate  DateTime? @map("resignation_date") @db.Date
  terminatedAt     DateTime? @map("terminated_at") @db.Timestamptz(6)
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// auth.users.id of the actor who created / last updated the row (soft reference).
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String    @map("updated_by") @db.Uuid

  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position       Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType EmploymentType  @relation(fields: [employmentTypeId], references: [id])
  employeeStatus EmployeeStatus  @relation(fields: [employeeStatusId], references: [id])
  accountAccessStatus EmployeeAccountAccessStatus? @relation(fields: [accountAccessStatusId], references: [id])
  onboardingMethod    EmployeeOnboardingMethod?    @relation(fields: [onboardingMethodId], references: [id])

  branchAssignments EmployeeBranchAssignment[]
  compensations     EmployeeCompensation[]
  workCalendars     EmployeeWorkCalendar[]
  workLocations     EmployeeWorkLocation[]
  assignmentHistory EmployeeAssignmentHistory[]
  shiftAssignments  ShiftAssignment[]
  coveredShiftAssignments ShiftAssignment[] @relation("ShiftCoversFor")
  attendanceEvents  AttendanceEvent[]
  attendanceDays    AttendanceDay[]
  attendanceAdjustments AttendanceAdjustment[]
  shiftMismatchRequests ShiftMismatchRequest[]
  leaveBalances     EmployeeLeaveBalance[]
  leaveRequests     LeaveRequest[]
  leaveCoverRequests LeaveRequest[] @relation("LeaveCoverEmployee")
  overtimeRequests  OvertimeRequest[]
  recurringPayItems EmployeeRecurringPayItem[]
  payrollAdjustments PayrollAdjustment[]
  payrollRunEmployees PayrollRunEmployee[]
  payslips          Payslip[]
  salaryAdvances    SalaryAdvance[]
  notifications     Notification[]
  documents         EmployeeDocument[]
  faceEnrollment    EmployeeFaceEnrollment?
  activationChallenges EmployeeActivationChallenge[]
  roleAssignments EmployeeRoleAssignment[]

  @@unique([organizationId, employeeCode])
  // Active+linked uniqueness is enforced by partial unique indexes in migration 0017
  // (allows terminated history rows to keep the same auth/platform user ids).
  @@index([organizationId])
  @@index([branchId])
  @@index([employeeStatusId])
  @@index([accountAccessStatusId])
  @@index([onboardingMethodId])
  @@index([organizationId, isActive])
  @@index([organizationId, authUserId])
  @@index([organizationId, platformUserId])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
  @@schema("hr")
}

model EmployeeRoleAssignment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  organizationRoleId String @map("organization_role_id") @db.Uuid
  sourcePositionId String? @map("source_position_id") @db.Uuid
  assignmentSourceId String? @map("assignment_source_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  isActive Boolean @default(true) @map("is_active")
  assignedBy String @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sourcePosition Position? @relation(fields: [sourcePositionId], references: [id], onDelete: SetNull)
  assignmentSource EmployeeRoleAssignmentSource? @relation(fields: [assignmentSourceId], references: [id], onDelete: Restrict)
  @@index([organizationId, employeeId, isActive])
  @@index([organizationRoleId])
  @@index([sourcePositionId])
  @@index([assignmentSourceId])
  @@map("employee_role_assignments")
  @@schema("hr")
}

model EmployeeRoleAssignmentSource {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  nameTh String @map("name_th")
  nameEn String @map("name_en")
  description String?
  sortOrder Int @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  isSystem Boolean @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments EmployeeRoleAssignment[]
  @@map("employee_role_assignment_sources")
  @@schema("hr")
}

/// OTP / invitation challenge for linking Auth to an employee (token stored hashed).
model EmployeeActivationChallenge {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  employeeId            String    @map("employee_id") @db.Uuid
  onboardingMethodId    String    @map("onboarding_method_id") @db.Uuid
  statusId              String    @map("status_id") @db.Uuid
  phoneNormalized       String?   @map("phone_normalized")
  tokenHash             String    @map("token_hash")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(6)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdByAuthUserId   String?   @map("created_by_auth_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  onboardingMethod EmployeeOnboardingMethod @relation(fields: [onboardingMethodId], references: [id])
  status           EmployeeActivationStatus @relation(fields: [statusId], references: [id])

  @@index([organizationId, employeeId])
  @@index([statusId])
  @@index([tokenHash])
  @@map("employee_activation_challenges")
  @@schema("hr")
}

/// Supporting files attached to an employee (ID card, contract, etc.).
model EmployeeDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  employeeId           String   @map("employee_id") @db.Uuid
  title                String
  category             String   @default("OTHER")
  fileName             String   @map("file_name")
  contentType          String   @map("content_type")
  byteSize             Int      @map("byte_size")
  storageKey           String   @map("storage_key")
  uploadedByAuthUserId String?  @map("uploaded_by_auth_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryAdvances  SalaryAdvance[]

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("employee_documents")
  @@schema("hr")
}

/// Employees may serve several branches; exactly one row should be primary at a time.
model EmployeeBranchAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  isPrimary     Boolean   @default(false) @map("is_primary")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId, effectiveFrom])
  @@index([employeeId, isPrimary])
  @@index([branchId])
  @@map("employee_branch_assignments")
  @@schema("hr")
}

// ─── Compensation ─────────────────────────────────────────────────────────

/// Append-only wage history. `isCurrent` marks the row payroll should read.
model EmployeeCompensation {
  id                    String    @id @default(uuid()) @db.Uuid
  employeeId            String    @map("employee_id") @db.Uuid
  wageTypeId            String    @map("wage_type_id") @db.Uuid
  amount                Decimal   @db.Decimal(14, 2)
  currency              String    @default("THB")
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  standardHoursPerDay   Decimal?  @map("standard_hours_per_day") @db.Decimal(5, 2)
  standardDaysPerMonth  Decimal?  @map("standard_days_per_month") @db.Decimal(5, 2)
  overtimeEligible      Boolean   @default(true) @map("overtime_eligible")
  isCurrent             Boolean   @default(true) @map("is_current")
  createdBy             String    @map("created_by") @db.Uuid
