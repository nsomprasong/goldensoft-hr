/// Salary advance (เบิกล่วงหน้า) — deducted on next payroll calculate when APPROVED.
model SalaryAdvance {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  amount                 Decimal   @db.Decimal(14, 2)
  advanceDate            DateTime  @map("advance_date") @db.Date
  reason                 String?
  /// SUBMITTED | APPROVED | PARTIALLY_DEDUCTED | DEDUCTED | REJECTED | CANCELLED | RECORDED
  status                 String    @default("SUBMITTED")
  installmentCount       Int       @default(1) @map("installment_count")
  startPayrollPeriodId   String?   @map("start_payroll_period_id") @db.Uuid
  /// CASH_ALREADY (รับเงินเลย) | WITH_SALARY (รับพร้อมเงินเดือน)
  disbursementMode       String?   @map("disbursement_mode")
  /// Employee document evidence when disbursementMode = CASH_ALREADY
  transferSlipDocumentId String?   @map("transfer_slip_document_id") @db.Uuid
  submittedAt            DateTime? @map("submitted_at") @db.Timestamptz(6)
  rejectedAt             DateTime? @map("rejected_at") @db.Timestamptz(6)
  reviewNote             String?   @map("review_note")
  creditedPayrollRunId   String?   @map("credited_payroll_run_id") @db.Uuid
  creditedAt             DateTime? @map("credited_at") @db.Timestamptz(6)
  deductedPayrollRunId   String?   @map("deducted_payroll_run_id") @db.Uuid
  deductedAt             DateTime? @map("deducted_at") @db.Timestamptz(6)
  createdByAuthUserId    String    @map("created_by_auth_user_id") @db.Uuid
  approvedByAuthUserId   String?   @map("approved_by_auth_user_id") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee             Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deductedPayrollRun   PayrollRun?                 @relation("AdvanceDeductedRun", fields: [deductedPayrollRunId], references: [id], onDelete: SetNull)
  creditedPayrollRun   PayrollRun?                 @relation("AdvanceCreditedRun", fields: [creditedPayrollRunId], references: [id], onDelete: SetNull)
  startPayrollPeriod   PayrollPeriod?              @relation(fields: [startPayrollPeriodId], references: [id], onDelete: SetNull)
  transferSlipDocument EmployeeDocument?           @relation(fields: [transferSlipDocumentId], references: [id], onDelete: SetNull)
  installments         SalaryAdvanceInstallment[]

  @@index([organizationId, status, advanceDate(sort: Desc)])
  @@index([employeeId, status])
  @@map("salary_advances")
  @@schema("hr")
}

model SalaryAdvanceInstallment {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  salaryAdvanceId      String    @map("salary_advance_id") @db.Uuid
  sequence             Int
  amount               Decimal   @db.Decimal(14, 2)
  /// Bound when a payroll run for a period is calculated (may be null until then).
  payrollPeriodId      String?   @map("payroll_period_id") @db.Uuid
  /// PENDING | DEDUCTED | CANCELLED
  status               String    @default("PENDING")
  deductedPayrollRunId String?   @map("deducted_payroll_run_id") @db.Uuid
  deductedAt           DateTime? @map("deducted_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  advance            SalaryAdvance  @relation(fields: [salaryAdvanceId], references: [id], onDelete: Cascade)
  payrollPeriod      PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  deductedPayrollRun PayrollRun?    @relation(fields: [deductedPayrollRunId], references: [id], onDelete: SetNull)

  @@unique([salaryAdvanceId, sequence])
  @@index([organizationId, payrollPeriodId, status])
  @@index([salaryAdvanceId, sequence])
  @@map("salary_advance_installments")
  @@schema("hr")
}

/// Tenant-configurable tax / SSO / late / absence rates for payroll estimates.
model PayrollDeductionSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  organizationId              String   @unique @map("organization_id") @db.Uuid
  taxEnabled                  Boolean  @default(true) @map("tax_enabled")
  /// FLAT | PROGRESSIVE (Phase 8 Track B).
  taxMethod                   String   @default("FLAT") @map("tax_method")
  taxRatePercent              Decimal  @default(0) @map("tax_rate_percent") @db.Decimal(8, 4)
  /// Annual personal allowance for progressive estimate.
  taxPersonalAllowance        Decimal  @default(60000) @map("tax_personal_allowance") @db.Decimal(14, 2)
  taxExpenseDeductionEnabled  Boolean  @default(true) @map("tax_expense_deduction_enabled")
  socialSecurityEnabled       Boolean  @default(true) @map("social_security_enabled")
  socialSecurityRatePercent   Decimal  @default(5) @map("social_security_rate_percent") @db.Decimal(8, 4)
  socialSecurityMaxAmount     Decimal  @default(750) @map("social_security_max_amount") @db.Decimal(14, 2)
  socialSecurityWageBaseMin   Decimal  @default(1650) @map("social_security_wage_base_min") @db.Decimal(14, 2)
  socialSecurityWageBaseMax   Decimal  @default(15000) @map("social_security_wage_base_max") @db.Decimal(14, 2)
  /// When true, sum attendance late minutes into a LATE deduction line.
  lateDeductionEnabled        Boolean  @default(true) @map("late_deduction_enabled")
  /// Baht per late minute. 0 = derive from daily wage ÷ 8 ÷ 60.
  lateBahtPerMinute           Decimal  @default(0) @map("late_baht_per_minute") @db.Decimal(14, 4)
  /// When true, count ABSENT attendance days into an ABSENCE deduction line.
  absenceDeductionEnabled     Boolean  @default(true) @map("absence_deduction_enabled")
  /// Baht per absent day. 0 = one day wage (monthly ÷ 30, daily as-is, hourly × 8).
  absenceBahtPerDay           Decimal  @default(0) @map("absence_baht_per_day") @db.Decimal(14, 2)
  updatedByAuthUserId         String?  @map("updated_by_auth_user_id") @db.Uuid
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payroll_deduction_settings")
  @@schema("hr")
}

model ApprovalAction {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  entityTypeId String @map("entity_type_id") @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  action String
  actorAuthUserId String @map("actor_auth_user_id") @db.Uuid
  comment String?
  metadata Json? @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  entityType ApprovalEntityType @relation(fields: [entityTypeId], references: [id])
  @@index([organizationId, entityTypeId, entityId, createdAt(sort: Desc)])
  @@map("approval_actions")
  @@schema("hr")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  recipientAuthUserId String? @map("recipient_auth_user_id") @db.Uuid
  recipientEmployeeId String? @map("recipient_employee_id") @db.Uuid
  typeId String @map("type_id") @db.Uuid
  statusId String @map("status_id") @db.Uuid
  title String
  body String
  entityType String? @map("entity_type")
  entityId String? @map("entity_id") @db.Uuid
  data Json? @db.JsonB
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  recipientEmployee Employee? @relation(fields: [recipientEmployeeId], references: [id], onDelete: SetNull)
  type NotificationType @relation(fields: [typeId], references: [id])
  status NotificationStatus @relation(fields: [statusId], references: [id])
  outbox NotificationOutbox[]
  @@index([recipientAuthUserId, statusId, createdAt(sort: Desc)])
  @@index([recipientEmployeeId, statusId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("hr")
}

model NotificationOutbox {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  channel String @default("IN_APP")
  payload Json @db.JsonB
  statusId String @map("status_id") @db.Uuid
  attemptCount Int @default(0) @map("attempt_count")
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status NotificationStatus @relation(fields: [statusId], references: [id])
  @@index([statusId, availableAt])
  @@map("notification_outbox")
  @@schema("hr")
}

/// Org-level face match policy for clock-in/out (Phase 8).
model AttendanceFaceSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @unique @map("organization_id") @db.Uuid
  /// OFF | WARN | REQUIRE
  mode                String   @default("OFF")
  /// Max Euclidean distance for a match (face-api 128-d; typical ~0.6).
  matchThreshold      Decimal  @default(0.55) @map("match_threshold") @db.Decimal(8, 4)
  updatedByAuthUserId String?  @map("updated_by_auth_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("attendance_face_settings")
  @@schema("hr")
}

/// Per-employee reference face descriptor + enrollment photo (Phase 8).
model EmployeeFaceEnrollment {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  employeeId           String   @unique @map("employee_id") @db.Uuid
  /// 128-d float descriptor (face-api faceRecognitionNet).
  descriptor           Json     @db.JsonB
  descriptorVersion    String   @default("face-api-128") @map("descriptor_version")
  photoUrl             String?  @map("photo_url")
  enrolledAt           DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  enrolledByAuthUserId String?  @map("enrolled_by_auth_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("employee_face_enrollments")
  @@schema("hr")
}
