# Application identity — Environment Guard refuses to run when this is not HR
APP_CODE=HR
NODE_ENV=development

# Supabase project pinning (shared Auth project with Platform)
EXPECTED_SUPABASE_PROJECT_REF=horyhrnqbeaivdztekfv
BLOCKED_LEGACY_SUPABASE_PROJECT_REF=invnwpyshxdadhocueeh

# Shared Supabase Auth (same project as Platform)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform origin used by the server-side Platform client
PLATFORM_BASE_URL=http://127.0.0.1:3000

# Must match Platform PLATFORM_CONTEXT_COOKIE_SECRET (signed gs_platform_ctx)
PLATFORM_CONTEXT_COOKIE_SECRET=

# HR app public URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001

# Chunk/asset prefix for Customer App embedding (default /__hr_assets).
# Customer App rewrites /__hr_assets/_next/* → this service. Leave unset to use
# the default; set empty only for pure standalone debugging.
HR_ASSET_PREFIX=/__hr_assets

# Product code sent to Platform entitlement checks
HR_PRODUCT_CODE=GOLDENSOFT_HR

# Never enable in production
ALLOW_TEST_AUTH=false

# PostgreSQL TLS — public Supabase CA bundle committed under certs/
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt

# Pooled runtime connection. Must NOT carry sslmode/sslrootcert query params;
# the runtime supplies a verified CA through pg.
DATABASE_URL=

# Direct connection for Prisma CLI. Must use
# sslmode=verify-full&sslrootcert=../certs/prod-ca-2021.crt
DIRECT_URL=

# system | development-demo | production-bootstrap
SEED_MODE=system
